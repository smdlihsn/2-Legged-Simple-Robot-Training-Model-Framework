<?xml version="1.0"?>
<robot name="crawler">

  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>
  <material name="red">
    <color rgba="0.8 0 0 1"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.4 0.2 0.1"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.4 0.2 0.1"/>
      </geometry>
    </collision>
  </link>

  <link name="left_arm">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0.1 0.03 0" rpy="0 0 1.571"/>
      <geometry>
        <box size="0.05 0.3 0.05"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0.1 0.03 0" rpy="0 0 1.571"/>
      <geometry>
        <box size="0.05 0.3 0.05"/>
      </geometry>
    </collision>
  </link>

  <link name="right_arm">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0.1 -0.03 0" rpy="0 0 1.571"/>
      <geometry>
        <box size="0.05 0.3 0.05"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0.1 -0.03 0" rpy="0 0 1.571"/>
      <geometry>
        <box size="0.05 0.3 0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_servo" type="revolute">
    <parent link="base_link"/>
    <child link="right_arm"/>
    <origin xyz="0 -0.1 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" lower="-1.57" upper="1.57" velocity="2.0"/>
  </joint>

  <joint name="left_servo" type="revolute">
    <parent link="base_link"/>
    <child link="left_arm"/>
    <origin xyz="0 0.1 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" lower="-1.57" upper="1.57" velocity="2.0"/>
  </joint>

</robot>